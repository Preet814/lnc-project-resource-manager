# Copy to .env before running: cp .env.example .env

# Database (postgres service hostname in Docker)
# For alembic/seed from WSL on your machine, use localhost instead of postgres:
# DATABASE_URL=postgresql://prm:prm@localhost:5432/prm
DATABASE_URL=postgresql://prm:prm@postgres:5432/prm

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Console client → REST API base URL
API_BASE_URL=http://api:8000


BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_EMAIL=

# JWT (generate a strong random secret for production)
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

# First-run system config seed only (applied once; later changes via admin API / console)
BOOTSTRAP_LLM_PROVIDER=GEMINI
BOOTSTRAP_LLM_API_KEY=
BOOTSTRAP_SCHEDULER_INTERVAL_HOURS=4
BOOTSTRAP_MAX_WEEKLY_HOURS=40

# LLM adapter settings (deploy-time; not changed via admin API)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile