# Copy to .env before running: cp .env.example .env

# Database (postgres service hostname in Docker)
# For alembic/seed from WSL on your machine, use localhost instead of postgres:
# DATABASE_URL=postgresql://prm:prm@localhost:5432/prm
DATABASE_URL=postgresql://prm:prm@postgres:5432/prm

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Background scheduler (runs inside the api container)
SCHEDULER_ENABLED=true
SCHEDULER_RUN_ON_STARTUP=true

# Console client → REST API base URL
API_BASE_URL=http://api:8000


BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_EMAIL=

# JWT (generate a strong random secret for production)
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

# First-run system config seed only (applied once; later changes via admin API / console)
BOOTSTRAP_LLM_PROVIDER=GEMINI
BOOTSTRAP_LLM_API_KEY=
BOOTSTRAP_SCHEDULER_INTERVAL_HOURS=4
BOOTSTRAP_MAX_WEEKLY_HOURS=40

# LLM adapter settings (deploy-time; not changed via admin API)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-1.5-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# Self-hosted Gemma (Ollama-compatible /api/generate; HTTP allowed)
GEMMA_BASE_URL=http://164.52.211.238
GEMMA_MODEL=gemma3:12b-it-q8_0

# Email (SMTP). Set SMTP_ENABLED=true for real delivery; false logs emails only.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PRM Notifications <noreply@example.com>
SMTP_USE_TLS=true

# Require OTP email verification after first password change
EMAIL_VERIFICATION_REQUIRED=true

# Timesheet notification cron (Asia/Kolkata)
TIMESHEET_NOTIFICATIONS_ENABLED=true
APP_TIMEZONE=Asia/Kolkata
TIMESHEET_REMINDER_CRON=0 9 * * mon,tue,wed
TIMESHEET_FREEZE_CRON=30 17 * * tue
TIMESHEET_WEDNESDAY_CRON=0 9 * * wed

# Project at-risk notification emails (scheduler health tick)
PROJECT_AT_RISK_NOTIFICATIONS_ENABLED=true
PROJECT_AT_RISK_REMINDER_DAYS=7