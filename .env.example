# Copy to .env before running: cp .env.example .env

# Database (postgres service hostname in Docker)
# For alembic/seed from WSL on your machine, use localhost instead of postgres:
# DATABASE_URL=postgresql://prm:prm@localhost:5432/prm
DATABASE_URL=postgresql://prm:prm@postgres:5432/prm

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Console client → REST API base URL
API_BASE_URL=http://api:8000
